#: api_admin_tools/views.py profile/models.py
#: profile/templates/email_welcome.html
#, python-format
msgid "Welcome to %(site_owner)s"
msgstr "Välkommen till %(site_owner)s"

#: api_general/views.py
#, python-format
msgid "Action Required: %(site_owner)s New Member Signup"
msgstr "Åtgärd krävs: ny medlemsregistrering hos %(site_owner)s"

#: api_general/views.py
msgid "Next Step: Register for an Induction"
msgstr "Nästa steg: anmäl dig till en introduktion"

#: api_general/views.py
#, python-format
msgid ""
"Hi %(first_name)s, thanks for signing up! The next step to becoming a fully "
"fledged member is to book in for an induction. During this induction we will "
"go over the basic safety and operational aspects of %(site_owner)s. To book "
"in, click the link below."
msgstr ""
"Hej %(first_name)s, tack för att du registrerade dig! Nästa steg för att bli "
"fullvärdig medlem är att boka en introduktion. Under introduktionen går vi "
"igenom grundläggande säkerhet och hur %(site_owner)s fungerar. Klicka på "
"länken nedan för att boka."

#: api_general/views.py
msgid "Register for Induction"
msgstr "Anmäl dig till introduktion"

#: profile/models.py
#, python-format
msgid "Reset your %(site_owner)s password"
msgstr "Återställ ditt lösenord hos %(site_owner)s"

#: profile/models.py
msgid "Action Required: Verify Email"
msgstr "Åtgärd krävs: verifiera din e-postadress"

#: profile/models.py
msgid "Verify Email"
msgstr "Verifiera e-postadress"

#: profile/models.py
msgid "Please verify your email address to activate your account."
msgstr "Verifiera din e-postadress för att aktivera ditt konto."

#: profile/models.py
msgid "Verify Now"
msgstr "Verifiera nu"

#: profile/models.py
msgid "Your membership application has been submitted"
msgstr "Din medlemsansökan har skickats in"

#: profile/models.py
msgid ""
"Thanks for submitting your membership application! Your membership "
"application has been submitted and you are now a 'member applicant'. Your "
"membership will be officially accepted shortly, but we have granted site "
"access immediately. You will receive an email confirming that your access "
"card has been enabled. If for some reason your membership is rejected within "
"this period, you will receive an email with further information."
msgstr ""
"Tack för att du skickade in din medlemsansökan! Din ansökan har skickats in "
"och du är nu 'ansökande medlem'. Ditt medlemskap godkänns inom kort, men vi "
"har redan gett dig åtkomst till lokalen. Du får ett e-postmeddelande som "
"bekräftar att ditt nyckelkort har aktiverats. Om ditt medlemskap av någon "
"anledning avslås under den här perioden får du ett e-postmeddelande med mer "
"information."

#: profile/models.py
#, python-format
msgid "Your %(site_owner)s site access has been disabled."
msgstr "Din åtkomst till %(site_owner)s har inaktiverats."

#: profile/models.py
#, python-format
msgid ""
"Your access to %(site_owner)s has been disabled. If this is unexpected, "
"please let us know."
msgstr ""
"Din åtkomst till %(site_owner)s har inaktiverats. Hör av dig till oss om det "
"kommer oväntat."

#: profile/models.py
#, python-format
msgid ""
"Your access to %(site_owner)s has been disabled because your membership "
"subscription has ended. This is usually due to a failed membership payment. "
"If this is unexpected, please let us know."
msgstr ""
"Din åtkomst till %(site_owner)s har inaktiverats eftersom din "
"medlemsprenumeration har upphört. Det beror oftast på en misslyckad "
"medlemsbetalning. Hör av dig till oss om det kommer oväntat."

#: profile/models.py
#, python-format
msgid "Your %(site_owner)s site access has been enabled."
msgstr "Din åtkomst till %(site_owner)s har aktiverats."

#: profile/models.py
#, python-format
msgid ""
"Great news %(first_name)s, your %(site_owner)s site access has been enabled."
msgstr ""
"Goda nyheter, %(first_name)s! Din åtkomst till %(site_owner)s har aktiverats."

#: profile/templates/email_password_reset.html
#, python-format
msgid ""
"Someone requested a password reset for your %(site_owner)s account. Click "
"the link in this email to reset it."
msgstr ""
"Någon har begärt att lösenordet till ditt konto hos %(site_owner)s ska "
"återställas. Klicka på länken i det här e-postmeddelandet för att återställa "
"det."

#: profile/templates/email_password_reset.html
msgid "Password Reset"
msgstr "Lösenordsåterställning"

#: profile/templates/email_password_reset.html
#, python-format
msgid ""
"Someone has just initiated a password reset for your %(site_owner)s account. "
"If this wasn't you, there's no need to worry. Simply ignore this email and "
"nothing will happen."
msgstr ""
"Någon har just begärt att lösenordet till ditt konto hos %(site_owner)s ska "
"återställas. Om det inte var du behöver du inte oroa dig – ignorera bara det "
"här e-postmeddelandet så händer ingenting."

#: profile/templates/email_password_reset.html
msgid "Reset Password"
msgstr "Återställ lösenord"

#: profile/templates/email_password_reset.html
#: profile/templates/email_with_button.html
msgid ""
"If that doesn't work, copy and paste the following link in your browser:"
msgstr ""
"Om det inte fungerar kan du kopiera och klistra in följande länk i din "
"webbläsare:"

#: profile/templates/email_password_reset.html
#: profile/templates/email_with_button.html
#: profile/templates/email_without_button.html
msgid ""
"If you have any questions, just reply to this email — we're always happy to "
"help out."
msgstr ""
"Om du har några frågor är det bara att svara på det här e-postmeddelandet – "
"vi hjälper gärna till."

#: profile/templates/email_password_reset.html
#: profile/templates/email_welcome.html
#: profile/templates/email_with_button.html
#: profile/templates/email_without_button.html
msgid "Cheers,"
msgstr "Vänliga hälsningar,"

#: profile/templates/email_password_reset.html
#: profile/templates/email_welcome.html
#: profile/templates/email_with_button.html
#: profile/templates/email_without_button.html
#, python-format
msgid ""
"Sent by <a href=\"%(site_url)s\">%(site_name)s</a> on behalf of "
"%(site_owner)s at %(site_address)s."
msgstr ""
"Skickat av <a href=\"%(site_url)s\">%(site_name)s</a> på uppdrag av "
"%(site_owner)s, %(site_address)s."

#: profile/templates/email_welcome.html
#, python-format
msgid ""
"Welcome to %(site_owner)s. Please read this email as it contains some "
"important information about how to get started."
msgstr ""
"Välkommen till %(site_owner)s. Läs det här e-postmeddelandet, det innehåller "
"viktig information om hur du kommer igång."

#: profile/templates/email_welcome.html
#, python-format
msgid ""
"Thanks for finishing your %(site_owner)s member induction. Now that you're "
"part of our community here are a few things to get you started."
msgstr ""
"Tack för att du har genomfört din introduktion hos %(site_owner)s. Nu när du "
"är en del av vår gemenskap kommer här några saker som hjälper dig att komma "
"igång."
