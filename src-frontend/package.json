{
  "name": "frontend",
  "version": "3.8.0",
  "description": "The MemberMatters frontend",
  "productName": "MemberMatters",
  "author": "Jaimyn Mayer <github@jaimyn.dev>",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build -m spa",
    "build:electron": "quasar build -m electron",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "lint": "npm run format && eslint --cache --fix --ext .js,.vue,.ts ./",
    "lint:precommit": "npm run format && eslint --ext .js,.ts,.vue ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "icongenie generate -i app-icon.png"
  },
  "dependencies": {
    "@quasar/extras": "^1.13.5",
    "@rollup/plugin-inject": "^5.0.3",
    "@stripe/stripe-js": "^5.10.0",
    "address": "^1.1.2",
    "apexcharts": "^5.10.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "csv-stringify": "^6.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "idle-timeout": "^2.6.0",
    "libphonenumber-js": "^1.13.14",
    "node-stdlib-browser": "^1.2.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.12.2",
    "vite-tsconfig-paths": "^4.2.0",
    "vue": "^3.2.33",
    "vue-i18n": "^9.2.0-beta.35",
    "vue-router": "^4.0.14",
    "vue3-apexcharts": "^1.5.3",
    "vuex": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^3.3.1",
    "@quasar/app-vite": "^1.4.3",
    "@quasar/icongenie": "^2.5.1",
    "@types/node": "^17.0.26",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "autoprefixer": "^10.4.2",
    "electron": "^44.5.1",
    "electron-packager": "^17.1.2",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-vue": "^8.7.1",
    "prettier": "^2.5.1",
    "typescript": "^4.5.4",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": "^22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
