{
  "name": "frontend",
  "version": "3.8.0",
  "description": "The MemberMatters frontend",
  "productName": "MemberMatters",
  "author": "Jaimyn Mayer <github@jaimyn.dev>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "predev:electron": "npm ci --prefix src-electron",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build -m spa",
    "prebuild:electron": "npm ci --prefix src-electron",
    "build:electron": "quasar build -m electron",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "lint": "npm run format && eslint --cache --fix --ext .js,.vue,.ts ./",
    "lint:precommit": "npm run format && eslint --ext .js,.ts,.vue ./",
    "test": "quasar prepare && vitest run",
    "test:watch": "quasar prepare && vitest",
    "icons": "icongenie generate -i app-icon.png"
  },
  "dependencies": {
    "@quasar/extras": "^1.13.5",
    "@stripe/stripe-js": "^5.10.0",
    "address": "^1.1.2",
    "apexcharts": "^5.10.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "csv-stringify": "^6.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "idle-timeout": "^2.6.0",
    "libphonenumber-js": "^1.13.14",
    "node-stdlib-browser": "^1.2.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.34.0",
    "vue": "^3.5.43",
    "vue-i18n": "^9.2.0-beta.35",
    "vue-router": "^5.3.1",
    "vue3-apexcharts": "^1.5.3",
    "vuex": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.1",
    "@quasar/icongenie": "^7.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": "^22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
